{
  "name": "@karmac/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "PRISMA_ENGINES_CACHE_DIR=/tmp/prisma-cache XDG_CACHE_HOME=/tmp/prisma-cache prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "prisma:migrate": "PRISMA_ENGINES_CACHE_DIR=/tmp/prisma-cache XDG_CACHE_HOME=/tmp/prisma-cache prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
