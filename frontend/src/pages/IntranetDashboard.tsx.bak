  { label: 'Llamar a La Económica por aprobación de crédito', time: '12:30', priority: 'Alta' },
  { label: 'Enviar cotización de lomo vetado premium', time: '15:00', priority: 'Media' },
  { label: 'Registrar visita a nueva sucursal Vitacura', time: '17:15', priority: 'Media' },
];

