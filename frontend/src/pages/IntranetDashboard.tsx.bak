  { label: 'Ventas del mes', value: '$42,8M', helper: '+12% vs. mes anterior', icon: TrendingUp, tone: 'green' },
  { label: 'Pipeline activo', value: '$18,6M', helper: '21 oportunidades abiertas', icon: PieChart, tone: 'amber' },
  { label: 'Clientes visitados', value: '38', helper: '7 pendientes esta semana', icon: Users, tone: 'blue' },
  { label: 'Pedidos hoy', value: '14', helper: '4 en despacho', icon: ShoppingCart, tone: 'red' },
